# Copier en `.env` puis adapter. Toutes les variables lues par src/config/settings/.
# En dev local, chaque variable a une valeur par défaut raisonnable : un .env
# vide suffit. En production, DJANGO_SECRET_KEY et DJANGO_ALLOWED_HOSTS sont
# OBLIGATOIRES (l'application refuse de démarrer sans).

# --- Django ---------------------------------------------------------------
# dev : config.settings.dev (défaut de manage.py)
# prod : config.settings.prod (défaut de wsgi/asgi)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Générer en prod : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Prod uniquement, séparés par des virgules : arcanum.example.fr,www.arcanum.example.fr
DJANGO_ALLOWED_HOSTS=
# Prod, optionnel, séparés par des virgules : https://arcanum.example.fr
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=arcanum
POSTGRES_USER=arcanum
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
